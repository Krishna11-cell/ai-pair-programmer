{
  "name": "ai-pair-programmer",
  "displayName": "CodeCritiq",
  "description": "Built an AI-powered pair programmer using Groq LLM and AST analysis for VS Code capable of automatically detecting bugs, security risks, and bad practices across 6 programming languages with inline diagnostics, hover explanations, and one-click Quick Fixes.",
  "version": "1.0.2",
  "publisher": "Krishna11-cell",
  "repository": {
    "type": "git",
    "url": "https://github.com/Krishna11-cell/ai-pair-programmer.git"
  },
  "bugs": {
    "url": "https://github.com/Krishna11-cell/ai-pair-programmer/issues"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:cpp",
    "onLanguage:c"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/dotenv": "^6.1.1",
    "@types/lodash": "^4.17.24",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.1.1",
    "lodash": "^4.18.1"
  }
}
